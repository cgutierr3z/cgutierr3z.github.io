---
import Icon from './Icon.astro';
import { es } from '../i18n/es';
import type { Project, ProjectLink } from '../data/types';

interface Props {
  project: Project;
  compact?: boolean;
}

const { project, compact = false } = Astro.props;

const linkLabel = (link: ProjectLink): string =>
	link.label?.trim() || (link.type === 'demo' ? 'Demo' : 'Repositorio');
---

<article
	class:list={[
		'flex h-full flex-col rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)]',
		compact ? 'p-5' : 'p-6',
		project.featured && 'border-t-2 border-t-[var(--color-accent)]',
	]}
	aria-labelledby={`${project.slug}-title`}
>
	<div class="flex items-center justify-between gap-3">
		<span
			class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-2.5 py-1 text-xs font-medium text-[var(--color-muted)]"
		>
			<span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)]" />
			{es.projectTypes[project.type]}
		</span>
		<span class="text-xs text-[var(--color-muted)]">{project.year}</span>
	</div>

	<h3
		id={`${project.slug}-title`}
		class:list={[
			'mt-4 font-semibold tracking-tight',
			compact ? 'text-base' : 'text-lg',
		]}
	>
		{project.title}
	</h3>

	<p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--color-muted)]">
		{project.summary}
	</p>

	{
		project.disclosure && (
			<p class="mt-3 text-xs text-[var(--color-muted)]">
				{project.disclosure}
			</p>
		)
	}

	<ul class="mt-4 flex flex-wrap gap-2" aria-label={es.labels.technologies}>
		{
			project.stack.map((technology) => (
				<li class="rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-2 py-1 text-xs text-[var(--color-muted)]">
					{technology}
				</li>
			))
		}
	</ul>

	<div class="mt-6 flex flex-wrap items-center gap-4">
		{
			project.links.map((link) => (
				<a
					href={link.url}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={`${linkLabel(link)} de ${project.title}. ${es.a11y.externalLink}`}
					class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-accent)] transition-colors hover:text-[var(--color-accent-hover)]"
				>
					{linkLabel(link)}
					<Icon name="external" class="h-3.5 w-3.5" />
				</a>
			))
		}
	</div>
</article>
