---
interface Props {
	label: string;
	value: string;
}

const { label, value } = Astro.props;
---

<article class="flex items-baseline gap-3 text-sm">
	<span
		class="font-mono tracking-[0.16em] text-[color:var(--color-ink-soft)]"
		aria-hidden="true"
	>{label}</span
	>
	<span class="font-medium text-[color:var(--color-ink)] tabular-nums">{value}</span>
</article>
