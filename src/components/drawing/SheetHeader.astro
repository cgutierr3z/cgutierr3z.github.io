---
interface Props {
	number: string;
	title: string;
}

const { number, title } = Astro.props;
---

<div class="flex items-baseline gap-4">
	<span
		class="font-mono text-xs tracking-[0.18em] text-[color:var(--ink-soft)]"
		aria-hidden="true"
	>{number}</span
	>
	<h2 class="font-sans text-3xl font-bold tracking-tight sm:text-4xl">
		{title}
	</h2>
</div>
