---
import { es } from '../../i18n/es';

interface Props {
	current?: string;
	compact?: boolean;
}

const { current, compact = false } = Astro.props;

const sheetIndex = [
	{ number: '00', label: es.header.home, href: '#inicio' },
	{ number: '01', label: es.sections.featuredProjects, href: '#proyectos' },
	{ number: '02', label: es.sections.otherProjects, href: '#otros-proyectos' },
	{ number: '03', label: es.sections.experience, href: '#experiencia' },
	{ number: '04', label: es.sections.stack, href: '#stack' },
	{ number: '05', label: es.sections.services, href: '#servicios' },
	{ number: '06', label: es.sections.about, href: '#sobre-mi' },
	{ number: '07', label: es.sections.contact, href: '#contacto' },
];
---

<ol
	class:list={[
		compact ? 'grid grid-cols-1 gap-2' : 'flex flex-wrap items-baseline gap-6',
	]}
>
	{
		sheetIndex.map((item) => (
			<li>
				<a
					href={item.href}
					aria-current={item.href === current ? 'true' : undefined}
					class="font-mono tracking-[0.18em] text-[color:var(--color-ink-soft)] transition-colors hover:text-[color:var(--color-ink)]"
				>
					{item.number} {item.label}
				</a>
			</li>
		))
	}
</ol>
