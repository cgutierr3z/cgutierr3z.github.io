---
interface Props {
	label: string;
	value: string;
}

const { label, value } = Astro.props;
---

<div class="flex items-baseline gap-2">
	<span
		class="font-mono text-xs tracking-[0.16em] text-[color:var(--color-ink-soft)]"
	>{label}</span
	>
	<span class="font-medium text-[color:var(--color-ink)] tabular-nums">{value}</span>
</div>
