---
import ReportSection from './ReportSection.astro';
import { technologies } from '../data/technologies';
import { es } from '../i18n/es';
---

<ReportSection
	id="stack"
	index="05"
	label={es.report.stack}
	title={es.sections.stack}
	description="Tecnologías con las que he trabajado en aplicaciones empresariales, integraciones y procesos de datos."
>
	<div class="border-t border-rule-strong">
		{
			technologies.map((group) => (
				<div class="grid gap-3 border-b border-rule py-5 md:grid-cols-[12rem_minmax(0,1fr)] md:gap-8">
					<h3 class="text-lg">{group.category}</h3>
					<ul class="flex flex-wrap gap-x-3 gap-y-1">
						{group.items.map((technology, index) => (
							<li class="text-sm text-ink-soft">
								{technology}
								{index < group.items.length - 1 && (
									<span aria-hidden="true" class="ml-3 text-rule-strong">
										/
									</span>
								)}
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</ReportSection>
