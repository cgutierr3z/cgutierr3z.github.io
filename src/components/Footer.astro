---
import { profile } from '../data/profile';
import { reportSections } from '../data/report';
import { es } from '../i18n/es';

const year = new Date().getFullYear();
---

<footer class="border-t border-rule-strong pb-10 pt-10">
	<div class="report-shell">
		<div class="grid gap-8 md:grid-cols-12" data-reveal>
			<div class="md:col-span-4">
				<p class="data text-oxide">{es.report.colophon}</p>
				<p class="mt-3 text-xl font-semibold tracking-tight">{profile.name}</p>
				<p class="text-sm text-ink-soft">{profile.role}</p>
				<p class="mt-5 text-xs text-ink-soft">
					© {year} {profile.name}. {es.footer.rights}
				</p>
			</div>

			<nav class="md:col-span-4" aria-label={es.footer.indexLabel}>
				<h2 class="data text-ink-soft">{es.footer.index}</h2>
				<ul class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2 text-sm">
					{
						reportSections.map((section) => (
							<li>
								<a
									href={section.href}
									class="text-ink-soft transition-colors hover:text-oxide"
								>
									{section.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<div class="md:col-span-4">
				<h2 class="data text-ink-soft">{es.footer.elsewhere}</h2>
				<ul class="mt-3 space-y-2 text-sm">
					<li>
						<a
							href={profile.github}
							target="_blank"
							rel="noopener noreferrer"
							class="link-underline inline-flex items-center gap-1.5 text-ink-soft hover:text-ink"
						>
							GitHub
							<span class="sr-only"> {es.a11y.externalLink}</span>
							<span aria-hidden="true">↗</span>
						</a>
					</li>
					<li>
						<a
							href={profile.linkedin}
							target="_blank"
							rel="noopener noreferrer"
							class="link-underline inline-flex items-center gap-1.5 text-ink-soft hover:text-ink"
						>
							LinkedIn
							<span class="sr-only"> {es.a11y.externalLink}</span>
							<span aria-hidden="true">↗</span>
						</a>
					</li>
					<li>
						<a
							href="https://github.com/cgutierr3z/cgutierr3z.github.io"
							target="_blank"
							rel="noopener noreferrer"
							class="link-underline inline-flex items-center gap-1.5 text-ink-soft hover:text-ink"
						>
							{es.labels.repo}
							<span class="sr-only"> {es.a11y.externalLink}</span>
							<span aria-hidden="true">↗</span>
						</a>
					</li>
				</ul>

				<p class="mt-6 text-xs leading-relaxed text-ink-soft">
					{es.footer.typefaces}
				</p>
				<p class="mt-1 text-xs text-ink-soft">{es.footer.builtWith}</p>
			</div>
		</div>

		<p class="mt-10 border-t border-rule pt-3 text-xs text-ink-soft">
			{es.labels.confidentialNote}
		</p>
	</div>
</footer>
