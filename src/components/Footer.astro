---
import { profile } from '../data/profile';
import { es } from '../i18n/es';

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--color-border)] py-10">
	<div
		class="mx-auto flex max-w-6xl flex-col gap-6 px-6 text-sm text-[var(--color-muted)] sm:flex-row sm:items-center sm:justify-between"
	>
		<div>
			<p class="font-semibold text-[var(--color-text)]">{profile.name}</p>
			<p class="mt-1">{profile.role}</p>
		</div>

		<div class="flex flex-wrap items-center gap-x-5 gap-y-2">
			<a
				href={profile.github}
				target="_blank"
				rel="noopener noreferrer"
				class="transition-colors hover:text-[var(--color-text)]"
			>
				GitHub
			</a>
			<a
				href={profile.linkedin}
				target="_blank"
				rel="noopener noreferrer"
				class="transition-colors hover:text-[var(--color-text)]"
			>
				LinkedIn
			</a>
			<a
				href="https://github.com/cgutierr3z/cgutierr3z.github.io"
				target="_blank"
				rel="noopener noreferrer"
				class="transition-colors hover:text-[var(--color-text)]"
			>
				Repositorio
			</a>
		</div>

		<div class="sm:text-right">
			<p>© {year} {profile.name}. {es.footer.rights}</p>
			<p class="mt-1">{es.footer.builtWith}</p>
		</div>
	</div>

	<div class="mx-auto mt-6 max-w-6xl px-6">
		<p class="text-xs text-[var(--color-muted)]">
			{es.labels.confidentialNote}
		</p>
	</div>
</footer>
