---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import SheetIndex from './drawing/SheetIndex.astro';
import { es } from '../i18n/es';
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper/90 backdrop-blur">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-6">
		<a href="/#inicio" class="flex items-center gap-3">
			<span class="sr-only">{es.header.home}</span>
			<span
				class="flex h-9 w-9 items-center justify-center rounded-md bg-ink text-sm font-bold text-paper"
				aria-hidden="true"
			>
				CG
			</span>
			<span class="font-semibold text-ink">Carlos Gutierrez</span>
		</a>

		<!-- Índice de láminas en escritorio -->
		<nav
			class="hidden flex-wrap gap-6 text-sm md:flex"
			aria-label={es.drawing.sheetIndex}
		>
			<SheetIndex />
		</nav>

		<div class="flex items-center gap-2">
			<ThemeToggle />
			<a
				href="#contacto"
				class="hidden rounded-md border border-rule-strong px-4 py-2 font-semibold text-ink transition-colors hover:border-oxide hover:bg-paper-raised sm:inline-flex"
			>
				{es.ctas.contact}
			</a>
			<button
				id="menu-toggle"
				type="button"
				class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-rule bg-paper text-ink-soft transition-colors hover:border-oxide hover:text-ink md:hidden"
				aria-label={es.a11y.openMenu}
				aria-controls="mobile-menu"
				aria-expanded="false"
				data-open-label={es.a11y.openMenu}
				data-close-label={es.a11y.closeMenu}
			>
				<Icon name="menu" class="h-5 w-5" />
			</button>
		</div>
	</div>

	<div id="mobile-menu" hidden class="md:hidden">
		<nav
			class="mx-auto max-w-6xl border-t border-rule px-6 py-4"
			aria-label={es.header.mobileNav}
		>
			<SheetIndex compact />
		</nav>
	</div>
</header>

<script is:inline>
	(() => {
		const button = document.getElementById('menu-toggle');
		const menu = document.getElementById('mobile-menu');
		if (!button || !menu) return;

		const desktop = window.matchMedia('(min-width: 768px)');
		const openLabel = button.dataset.openLabel || 'Abrir menú';
		const closeLabel = button.dataset.closeLabel || 'Cerrar menú';

		const setOpen = (open) => {
			menu.hidden = !open;
			button.setAttribute('aria-expanded', String(open));
			button.setAttribute('aria-label', open ? closeLabel : openLabel);
		};

		button.addEventListener('click', () => setOpen(menu.hidden));
		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !menu.hidden) {
				setOpen(false);
				button.focus();
			}
		});
		desktop.addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});
	})();
</script>
