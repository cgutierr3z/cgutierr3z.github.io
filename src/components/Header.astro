---
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { es } from '../i18n/es';

const navItems = [
	{ href: '#servicios', label: es.nav.services },
	{ href: '#proyectos', label: es.nav.projects },
	{ href: '#experiencia', label: es.nav.experience },
	{ href: '#stack', label: es.nav.stack },
	{ href: '#sobre-mi', label: es.nav.about },
];
---

<header class="sticky top-0 z-40 border-b border-rule bg-paper">
	<div class="report-shell flex h-16 items-center justify-between gap-4">
		<a href="/" class="flex items-center gap-3">
			<span class="sr-only">{es.header.home}</span>
			<span
				class="flex h-9 w-9 items-center justify-center border border-ink bg-ink font-mono text-xs font-bold tracking-[0.08em] text-paper"
				aria-hidden="true"
			>
				CG
			</span>
			<span class="hidden text-sm font-semibold sm:inline">
				Carlos Gutierrez
			</span>
		</a>

		<nav
			class="hidden items-center gap-7 md:flex"
			aria-label={es.header.mainNav}
		>
			{
				navItems.map((item) => (
					<a
						href={item.href}
						class="text-sm font-medium text-ink-soft transition-colors hover:text-oxide"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2">
			<ThemeToggle />
			<a
				href="#contacto"
				class="hidden bg-oxide px-4 py-2 text-sm font-semibold text-on-signal transition-colors hover:bg-oxide-strong sm:inline-flex"
			>
				{es.ctas.contact}
			</a>
			<button
				id="menu-toggle"
				type="button"
				class="inline-flex h-10 w-10 items-center justify-center border border-rule text-ink-soft transition-colors hover:border-oxide hover:text-ink md:hidden"
				aria-label={es.a11y.openMenu}
				aria-controls="mobile-menu"
				aria-expanded="false"
				data-open-label={es.a11y.openMenu}
				data-close-label={es.a11y.closeMenu}
			>
				<Icon name="menu" class="h-5 w-5" />
			</button>
		</div>
	</div>

	<div id="mobile-menu" hidden class="border-t border-rule bg-paper-raised md:hidden">
		<nav class="report-shell py-4" aria-label={es.header.mobileNav}>
			<ul class="flex flex-col gap-1">
				{
					navItems.map((item) => (
						<li>
							<a
								href={item.href}
								class="block px-3 py-2 text-sm font-medium text-ink-soft transition-colors hover:bg-paper hover:text-ink"
							>
								{item.label}
							</a>
						</li>
					))
				}
			</ul>
			<a
				href="#contacto"
				class="mt-4 inline-flex bg-oxide px-4 py-2 text-sm font-semibold text-on-signal transition-colors hover:bg-oxide-strong"
			>
				{es.ctas.contact}
			</a>
		</nav>
	</div>
</header>

<script is:inline>
	(() => {
		const button = document.getElementById('menu-toggle');
		const menu = document.getElementById('mobile-menu');
		if (!button || !menu) return;

		const desktop = window.matchMedia('(min-width: 768px)');
		const openLabel = button.dataset.openLabel || 'Abrir menú';
		const closeLabel = button.dataset.closeLabel || 'Cerrar menú';

		const setOpen = (open) => {
			menu.hidden = !open;
			button.setAttribute('aria-expanded', String(open));
			button.setAttribute('aria-label', open ? closeLabel : openLabel);
		};

		button.addEventListener('click', () => {
			setOpen(menu.hidden);
		});

		menu.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && !menu.hidden) {
				setOpen(false);
				button.focus();
			}
		});

		desktop.addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});
	})();
</script>
