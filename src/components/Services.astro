---
import Icon from './Icon.astro';
import Section from './Section.astro';
import { services } from '../data/services';
import { es } from '../i18n/es';
---

<Section
	id="servicios"
	eyebrow="Qué hago"
	title={es.sections.services}
	description="Servicios construidos sobre experiencia real en aplicaciones empresariales, migraciones, APIs y datos."
>
	<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{
			services.map((service) => (
				<article class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-colors hover:border-[var(--color-accent)]">
					<div class="flex h-11 w-11 items-center justify-center rounded-lg border border-[var(--color-border)] bg-[var(--color-bg)] text-[var(--color-accent)]">
						<Icon name={service.icon} class="h-5 w-5" />
					</div>
					<h3 class="mt-5 text-base font-semibold">{service.title}</h3>
					<p class="mt-2 text-sm leading-relaxed text-[var(--color-muted)]">
						{service.description}
					</p>
				</article>
			))
		}
	</div>
</Section>
