---
import Icon from './Icon.astro';
import ReportSection from './ReportSection.astro';
import { services } from '../data/services';
import { es } from '../i18n/es';
---

<ReportSection
	id="servicios"
	index="01"
	label={es.report.services}
	title={es.sections.services}
	description="Servicios construidos sobre experiencia real en aplicaciones empresariales, migraciones, APIs y datos."
>
	<ol class="border-t border-rule-strong">
		{
			services.map((service, index) => (
				<li class="grid gap-x-8 gap-y-3 border-b border-rule py-6 md:grid-cols-[3.5rem_minmax(0,1fr)_10rem] md:items-baseline">
					<p class="data text-oxide">{`0${index + 1}`}</p>
					<div>
						<h3>{service.title}</h3>
						<p class="prose-measure mt-2 text-ink-soft">
							{service.description}
						</p>
					</div>
					<p class="data text-ink-soft md:text-right">
						{es.serviceScopes[
							service.id as keyof typeof es.serviceScopes
						] ?? service.id}
					</p>
				</li>
			))
		}
	</ol>

	<div class="mt-8 flex justify-end">
		<a
			href="#contacto"
			class="inline-flex items-center gap-2 text-sm font-semibold text-oxide transition-colors hover:text-oxide-strong"
		>
			{es.ctas.contact}
			<Icon name="arrow" class="h-4 w-4" />
		</a>
	</div>
</ReportSection>
