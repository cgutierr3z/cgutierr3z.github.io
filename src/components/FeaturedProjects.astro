---
import ProjectCard from './ProjectCard.astro';
import ReportSection from './ReportSection.astro';
import { featuredProjects } from '../data/projects';
import { es } from '../i18n/es';
---

<ReportSection
	id="proyectos"
	index="02"
	label={es.report.selectedWork}
	title={es.sections.featuredProjects}
	description="Proyectos web y Full Stack que muestran mi experiencia con aplicaciones, APIs y datos."
>
	<div class="grid gap-4 lg:grid-cols-3">
		{
			featuredProjects.map((project) => (
				<div id={`proyecto-${project.slug}`} class="scroll-mt-24">
					<ProjectCard project={project} />
				</div>
			))
		}
	</div>
</ReportSection>
