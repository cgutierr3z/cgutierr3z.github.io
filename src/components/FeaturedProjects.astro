---
import ProjectEntry from './ProjectEntry.astro';
import ReportSection from './ReportSection.astro';
import { featuredProjects } from '../data/projects';
import { es } from '../i18n/es';
---

<ReportSection
	id="proyectos"
	index="02"
	label={es.report.selectedWork}
	title={es.sections.featuredProjects}
	description="Proyectos web y Full Stack que muestran mi experiencia con aplicaciones, APIs y datos."
>
	<div class="border-b border-rule-strong">
		{
			featuredProjects.map((project, index) => (
				<ProjectEntry project={project} index={index} />
			))
		}
	</div>
</ReportSection>
