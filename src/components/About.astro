---
import ReportSection from './ReportSection.astro';
import { es } from '../i18n/es';
---

<ReportSection
	id="sobre-mi"
	index="06"
	label={es.report.about}
	title={es.sections.about}
>
	<div class="grid gap-10 md:grid-cols-12 md:gap-12">
		<div class="space-y-4 md:col-span-7">
			<p class="prose-measure text-lg leading-relaxed">
				{es.about.paragraphOne}
			</p>
			<p class="prose-measure text-ink-soft">
				{es.about.paragraphTwo}
			</p>
		</div>

		<div class="md:col-span-5">
			<h3 class="data border-t border-rule-strong pt-3 text-ink-soft">
				{es.about.principlesLabel}
			</h3>
			<ul class="mt-4 border-t border-rule">
				{
					es.about.principles.map((principle) => (
						<li class="border-b border-rule py-2.5 text-sm">{principle}</li>
					))
				}
			</ul>
			<p class="data mt-8 text-ink-soft">{es.about.signature}</p>
		</div>
	</div>
</ReportSection>
