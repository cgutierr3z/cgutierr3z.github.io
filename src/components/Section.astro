---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  description?: string;
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  description,
  class: className = '',
} = Astro.props;
---

<section
	id={id}
	class:list={['scroll-mt-24 py-16 sm:py-20', className]}
	aria-labelledby={`${id}-title`}
>
	<div class="mx-auto max-w-6xl px-6">
		<div class="max-w-2xl">
			{eyebrow && (
				<p class="text-sm font-semibold uppercase tracking-[0.18em] text-[var(--color-accent)]">
					{eyebrow}
				</p>
			)}
			<h2
				id={`${id}-title`}
				class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl"
			>
				{title}
			</h2>
			{description && (
				<p class="mt-4 text-base leading-relaxed text-[var(--color-muted)]">
					{description}
				</p>
			)}
		</div>
		<div class="mt-10">
			<slot />
		</div>
	</div>
</section>
