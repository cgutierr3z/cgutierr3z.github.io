---
import ChapterHeader from './ChapterHeader.astro';
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { es } from '../i18n/es';
---

<section
	id="contacto"
	class="field-oxide scroll-mt-24 py-[var(--space-section)]"
	aria-labelledby="contacto-title"
>
	<div class="report-shell">
		<ChapterHeader
			id="contacto"
			index="07"
			label={es.report.contact}
			title={es.contact.title}
			description={es.contact.description}
			tone="signal"
		/>

		<div class="mt-10 grid gap-8 border-t border-on-signal/50 pt-8 md:grid-cols-12 md:gap-12">
			<div class="md:col-span-7">
				<h3 class="text-2xl sm:text-3xl">{es.contact.heading}</h3>
				<p class="prose-measure mt-3">
					{profile.email
						? es.contact.bodyWithEmail
						: es.contact.bodyWithoutEmail}
				</p>
			</div>

			<div class="md:col-span-5">
				<p class="data">{es.contact.emailLabel}</p>
				{
					profile.email && (
						<a
							href={`mailto:${profile.email}`}
							class="mt-2 inline-block break-all text-xl font-semibold underline decoration-on-signal/50 underline-offset-4 transition-colors hover:decoration-on-signal sm:text-2xl"
						>
							{profile.email}
						</a>
					)
				}

				<p class="data mt-6">{es.contact.alsoAt}</p>
				<ul class="mt-2 flex flex-wrap gap-x-5 gap-y-2">
					<li>
						<a
							href={profile.github}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1.5 text-sm font-semibold underline decoration-on-signal/50 underline-offset-4 transition-colors hover:decoration-on-signal"
						>
							{es.ctas.github}
							<Icon name="external" class="h-3.5 w-3.5" />
							<span class="sr-only"> {es.a11y.externalLink}</span>
						</a>
					</li>
					<li>
						<a
							href={profile.linkedin}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-1.5 text-sm font-semibold underline decoration-on-signal/50 underline-offset-4 transition-colors hover:decoration-on-signal"
						>
							{es.ctas.linkedin}
							<Icon name="external" class="h-3.5 w-3.5" />
							<span class="sr-only"> {es.a11y.externalLink}</span>
						</a>
					</li>
				</ul>
			</div>
		</div>
	</div>
</section>
