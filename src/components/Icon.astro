---
type IconName =
  | 'code'
  | 'migration'
  | 'api'
  | 'data'
  | 'support'
  | 'docker'
  | 'sun'
  | 'moon'
  | 'menu'
  | 'external'
  | 'arrow'
  | 'check'
  | 'mail'
  | 'lock';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
>
	{name === 'code' && (
		<>
			<polyline points="16 18 22 12 16 6" />
			<polyline points="8 6 2 12 8 18" />
		</>
	)}
	{name === 'migration' && (
		<>
			<path d="M4 7h11" />
			<path d="m12 4 3 3-3 3" />
			<path d="M20 17H9" />
			<path d="m12 14-3 3 3 3" />
		</>
	)}
	{name === 'api' && (
		<>
			<rect x="3" y="4" width="18" height="6" rx="2" />
			<rect x="3" y="14" width="18" height="6" rx="2" />
			<path d="M7 7h.01M7 17h.01" />
		</>
	)}
	{name === 'data' && (
		<>
			<ellipse cx="12" cy="5" rx="8" ry="3" />
			<path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5" />
			<path d="M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6" />
		</>
	)}
	{name === 'support' && (
		<>
			<circle cx="12" cy="12" r="9" />
			<circle cx="12" cy="12" r="4" />
			<path d="m4.93 4.93 4.24 4.24M14.83 14.83l4.24 4.24M14.83 9.17l4.24-4.24M9.17 14.83l-4.24 4.24" />
		</>
	)}
	{name === 'docker' && (
		<>
			<path d="M3 13h18" />
			<path d="M5 13V9h4v4" />
			<path d="M9 9V5h4v8" />
			<path d="M13 13V9h4v4" />
			<path d="M3 17c2 2 5 2 8 2s6 0 8-2" />
		</>
	)}
	{name === 'sun' && (
		<>
			<circle cx="12" cy="12" r="4" />
			<path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
		</>
	)}
	{name === 'moon' && (
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
	)}
	{name === 'menu' && (
		<path d="M4 6h16M4 12h16M4 18h16" />
	)}
	{name === 'external' && (
		<>
			<path d="M14 3h7v7" />
			<path d="M10 14 21 3" />
			<path d="M21 14v5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5" />
		</>
	)}
	{name === 'arrow' && (
		<>
			<path d="M5 12h14" />
			<path d="m13 6 6 6-6 6" />
		</>
	)}
	{name === 'check' && <path d="m5 12 4 4L19 6" />}
	{name === 'mail' && (
		<>
			<rect x="3" y="5" width="18" height="14" rx="2" />
			<path d="m3 7 9 6 9-6" />
		</>
	)}
	{name === 'lock' && (
		<>
			<rect x="5" y="11" width="14" height="10" rx="2" />
			<path d="M8 11V7a4 4 0 0 1 8 0v4" />
		</>
	)}
</svg>
