---
import { reportMetrics } from '../data/report';
import { es } from '../i18n/es';

interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['field-patina', className]}>
	<div class="report-shell py-6 sm:py-9">
		<div class="flex items-baseline justify-between gap-4 border-b border-on-signal/30 pb-3">
			<h2 class="data">{es.report.highlights}</h2>
			<p class="data hidden sm:block">{es.report.period}</p>
		</div>

		<dl class="grid sm:grid-cols-3">
			{
				reportMetrics.map((metric, index) => (
					<div
						class:list={[
							'flex flex-col-reverse gap-2 py-4 sm:py-6',
							index > 0 &&
								'border-t border-on-signal/30 sm:border-l sm:border-t-0 sm:pl-6',
							index === 0 && 'sm:pr-6',
						]}
					>
						<dt class="data">{metric.label}</dt>
						<dd class="text-[clamp(2.75rem,6vw,4.5rem)] font-semibold leading-none tracking-[-0.045em] tabular-nums">
							{metric.value}
						</dd>
					</div>
				))
			}
		</dl>

		<p class="mt-3 text-xs leading-relaxed">{reportMetrics[0].note}</p>
	</div>
</div>
