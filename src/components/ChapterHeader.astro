---
interface Props {
  id: string;
  index: string;
  title: string;
  label?: string;
  description?: string;
}

const { id, index, title, label, description } = Astro.props;
---

<header>
	<div class="flex items-baseline justify-between gap-4 border-t border-rule-strong pt-3">
		<p class="data text-oxide">{index}</p>
		{label && <p class="data text-ink-soft">{label}</p>}
	</div>

	<div class="mt-6 grid gap-x-10 gap-y-4 md:grid-cols-12 md:items-start">
		<h2 id={`${id}-title`} class="md:col-span-7">{title}</h2>
		{
			description && (
				<p class="prose-measure text-ink-soft md:col-span-5 md:pt-2">
					{description}
				</p>
			)
		}
	</div>
</header>
