---
interface Props {
	id: string;
	index: string;
	title: string;
	label?: string;
	description?: string;
	tone?: 'paper' | 'signal';
}

const { id, index, title, label, description, tone = 'paper' } = Astro.props;

const ruleClass =
	tone === 'signal' ? 'border-on-signal/50' : 'border-rule-strong';
const indexClass = tone === 'signal' ? 'text-on-signal' : 'text-oxide';
const mutedClass = tone === 'signal' ? 'text-on-signal' : 'text-ink-soft';
---

<header>
	<div class:list={['flex items-baseline justify-between gap-4 border-t pt-3', ruleClass]}>
		<p class:list={['data', indexClass]}>{index}</p>
		{label && <p class:list={['data', mutedClass]}>{label}</p>}
	</div>

	<div class="mt-6 grid gap-x-10 gap-y-4 md:grid-cols-12 md:items-start">
		<h2 id={`${id}-title`} class="md:col-span-7">{title}</h2>
		{
			description && (
				<p class:list={['prose-measure md:col-span-5 md:pt-2', mutedClass]}>
					{description}
				</p>
			)
		}
	</div>
</header>
