---
import Icon from './Icon.astro';
import { es } from '../i18n/es';

interface Props {
	class?: string;
}

const { class: className = '' } = Astro.props;
---

<button
	id="theme-toggle"
	type="button"
	class:list={[
		'theme-toggle inline-flex h-10 w-10 items-center justify-center border border-rule text-ink-soft transition-colors hover:border-oxide hover:text-ink',
		className,
	]}
	aria-label={es.theme.toggle}
	aria-pressed="false"
	data-light-label={es.theme.switchToLight}
	data-dark-label={es.theme.switchToDark}
>
	<Icon name="sun" class="theme-icon-sun h-5 w-5" />
	<Icon name="moon" class="theme-icon-moon h-5 w-5" />
</button>

<script is:inline>
	(() => {
		const buttons = document.querySelectorAll('.theme-toggle');
		if (buttons.length === 0) return;

		const root = document.documentElement;
		const lightLabel = buttons[0].dataset.lightLabel || 'Cambiar a tema claro';
		const darkLabel = buttons[0].dataset.darkLabel || 'Cambiar a tema oscuro';

		const updateLabels = () => {
			const isDark = root.dataset.theme === 'dark';
			buttons.forEach((button) => {
				button.setAttribute('aria-label', isDark ? lightLabel : darkLabel);
				button.setAttribute('aria-pressed', String(isDark));
			});
		};

		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
				root.dataset.theme = next;
				try {
					localStorage.setItem('theme', next);
				} catch {
					// Si localStorage no está disponible, el tema cambia solo en la sesión.
				}
				updateLabels();
			});
		});

		updateLabels();
	})();
</script>
