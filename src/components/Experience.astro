---
import Icon from './Icon.astro';
import Section from './Section.astro';
import { experience } from '../data/experience';
import { es } from '../i18n/es';
import { formatMonth } from '../utils/format';
---

<Section
	id="experiencia"
	eyebrow="Trayectoria"
	title={es.sections.experience}
	description="Experiencia en aplicaciones empresariales, migraciones de formularios, APIs y procesos de datos."
>
	<div class="space-y-6">
		{
			experience.map((job) => (
				<article class="rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 sm:p-8">
					<div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
						<div>
							<div class="flex flex-wrap items-center gap-2">
								<h3 class="text-xl font-semibold">{job.role}</h3>
								{job.companyConfidential && (
									<span class="inline-flex items-center gap-1 rounded-full border border-[var(--color-border)] bg-[var(--color-bg)] px-2.5 py-1 text-xs font-medium text-[var(--color-muted)]">
										<Icon name="lock" class="h-3.5 w-3.5" />
										{es.labels.confidential}
									</span>
								)}
							</div>
							<p class="mt-1 text-sm text-[var(--color-muted)]">{job.company}</p>
						</div>
						<p class="text-sm font-medium text-[var(--color-muted)]">
							<time datetime={job.start}>{formatMonth(job.start)}</time>
							{' — '}
							{job.end ? (
								<time datetime={job.end}>{formatMonth(job.end)}</time>
							) : (
								'Actualidad'
							)}
						</p>
					</div>

					<p class="mt-5 max-w-4xl text-sm leading-relaxed text-[var(--color-muted)]">
						{job.summary}
					</p>

					<div class="mt-6">
						<h4 class="text-sm font-semibold uppercase tracking-[0.16em] text-[var(--color-muted)]">
							{es.labels.achievements}
						</h4>
						<ul class="mt-3 grid gap-2 sm:grid-cols-2">
							{job.achievements.map((achievement) => (
								<li class="flex items-start gap-2 text-sm leading-relaxed">
									<Icon
										name="check"
										class="mt-0.5 h-4 w-4 shrink-0 text-[var(--color-accent)]"
									/>
									{achievement}
								</li>
							))}
						</ul>
					</div>

					<details class="mt-6 border-t border-[var(--color-border)] pt-4">
						<summary class="cursor-pointer text-sm font-semibold">
							{es.labels.responsibilities}
						</summary>
						<ul class="mt-3 space-y-2 text-sm leading-relaxed text-[var(--color-muted)]">
							{job.responsibilities.map((responsibility) => (
								<li class="flex items-start gap-2">
									<span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[var(--color-accent)]" />
									{responsibility}
								</li>
							))}
						</ul>
					</details>

					<ul
						class="mt-6 flex flex-wrap gap-2"
						aria-label={es.labels.technologies}
					>
						{job.stack.map((technology) => (
							<li class="rounded-md border border-[var(--color-border)] bg-[var(--color-bg)] px-2 py-1 text-xs text-[var(--color-muted)]">
								{technology}
							</li>
						))}
					</ul>

					{job.companyConfidential && (
						<p class="mt-4 text-xs text-[var(--color-muted)]">
							{es.labels.confidentialNote}
						</p>
					)}
				</article>
			))
		}
	</div>
</Section>
